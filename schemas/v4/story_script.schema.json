{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://femsj.local/schemas/v4/story_script.schema.json",
  "title": "femsj V4 Story Script",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "scope",
    "evidenceKind",
    "scenes"
  ],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^4\\.[0-9]+(\\.[0-9]+)?$"
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "evidenceKind": {
      "const": "DEV_BLUEPRINT"
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/scene"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_\\-.]{2,79}$"
    },
    "line": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "speakerId",
        "textKey",
        "emotion",
        "animation"
      ],
      "properties": {
        "speakerId": {
          "$ref": "#/$defs/id"
        },
        "textKey": {
          "type": "string",
          "pattern": "^story\\.[a-z0-9_.-]+$"
        },
        "emotion": {
          "type": "string",
          "minLength": 1
        },
        "animation": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "day",
        "trigger",
        "lines",
        "evidenceKind"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "day": {
          "type": "integer",
          "minimum": 1,
          "maximum": 999
        },
        "trigger": {
          "enum": [
            "DAY_ENTRY",
            "DAY_EXIT",
            "BUILD"
          ]
        },
        "buildNodeId": {
          "type": [
            "string",
            "null"
          ]
        },
        "lines": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/line"
          }
        },
        "evidenceKind": {
          "const": "DEV_BLUEPRINT"
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
