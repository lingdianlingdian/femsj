{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://femsj.local/schemas/v4/character_canon.schema.json",
  "title": "V4 Character Canon Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "generatedAt",
    "disclaimer",
    "globalCanon",
    "characters"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "generatedAt": {
      "type": "string"
    },
    "disclaimer": {
      "type": "string",
      "minLength": 1
    },
    "globalCanon": {
      "type": "object",
      "required": [
        "gooseSilhouette",
        "outline",
        "lightDirection",
        "shadow",
        "eyeRule",
        "beakRule",
        "footRule",
        "forbidden"
      ],
      "properties": {
        "gooseSilhouette": {
          "type": "string"
        },
        "outline": {
          "type": "string"
        },
        "lightDirection": {
          "type": "string"
        },
        "shadow": {
          "type": "string"
        },
        "eyeRule": {
          "type": "string"
        },
        "beakRule": {
          "type": "string"
        },
        "footRule": {
          "type": "string"
        },
        "forbidden": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "characters": {
      "type": "array",
      "minItems": 24,
      "items": {
        "$ref": "#/$defs/character"
      }
    }
  },
  "$defs": {
    "character": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "role",
        "species",
        "tier",
        "palette",
        "ratio",
        "height",
        "props",
        "traits",
        "forbid",
        "dialogue",
        "expressions",
        "animations",
        "avatarCrop",
        "sceneScale",
        "evidenceKind",
        "canonViews",
        "assetIds"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^char_[a-z0-9_]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "PROTAGONIST",
            "MAJOR_GUEST",
            "MINOR_GUEST",
            "BACKGROUND"
          ]
        },
        "species": {
          "type": "string",
          "minLength": 1
        },
        "tier": {
          "enum": [
            "S",
            "A",
            "B",
            "C"
          ]
        },
        "palette": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          }
        },
        "ratio": {
          "type": "number",
          "minimum": 0.2,
          "maximum": 2
        },
        "height": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 10
        },
        "props": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "traits": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "forbid": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "job": {
          "type": "string"
        },
        "dialogue": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "expressions": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "string"
          }
        },
        "animations": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string"
          }
        },
        "avatarCrop": {
          "type": "object",
          "required": [
            "headTop",
            "bodyBottom"
          ],
          "properties": {
            "headTop": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "bodyBottom": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "additionalProperties": false
        },
        "sceneScale": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "evidenceKind": {
          "enum": [
            "DEV_BLUEPRINT"
          ]
        },
        "canonViews": {
          "type": "array",
          "minItems": 5,
          "contains": {
            "const": "Front"
          },
          "items": {
            "enum": [
              "Front",
              "ThreeQuarter",
              "Side",
              "Back",
              "Expressions"
            ]
          }
        },
        "assetIds": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^char_[a-z0-9_]+_(canon_sheet|avatar|story|spine)$"
          }
        }
      }
    }
  }
}
