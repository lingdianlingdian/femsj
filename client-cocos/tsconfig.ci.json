{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2020", "DOM"],
    "noEmit": true,
    "skipLibCheck": true,
    "strict": false,
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "baseUrl": ".",
    "typeRoots": ["./types"]
  },
  "include": [
    "assets/scripts/**/*.ts",
    "types/**/*.d.ts"
  ]
}
